// #include "RetroPad.dtsi"

/ {
        chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        };

        default_transform: keymap_transform_0 {
                compatible = "zmk,matrix-transform";
                columns = <4>;
                rows = <5>;
                map = <
                RC(0,0) RC(0,1) RC(0,2) RC(0,3)
                RC(1,0) RC(1,1) RC(1,2) RC(1,3)
                RC(2,0) RC(2,1) RC(2,2) 
                RC(3,0) RC(3,1) RC(3,2) RC(3,3)
                RC(4,0)         RC(4,2) 
                >;
        };

        kscan0: kscan {
                compatible = "zmk,kscan-gpio-matrix";
                label = "default_kscan";
                diode-direction = "col2row";

                row-gpios = <&pro_micro  31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&pro_micro  29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&pro_micro   2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&pro_micro 115 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&pro_micro 113 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

                col-gpios = <&pro_micro  10 GPIO_ACTIVE_HIGH>,
                            <&pro_micro   9 GPIO_ACTIVE_HIGH>,
                            <&pro_micro 106 GPIO_ACTIVE_HIGH>,
                           <&pro_micro 104 GPIO_ACTIVE_HIGH>;
        };
};